{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    "ServiceName": "mymaster",
    "Sentinels": [
      "sentinel-1:26379",
      "sentinel-2:26379",
      "sentinel-3:26379"
    ],
    "ConnectTimeoutMilliseconds": 5000,
    "OperationTimeoutMilliseconds": 5000,
    "ConnectRetryCount": 3,
    "StartupRetryCount": 5,
    "StartupRetryDelayMilliseconds": 1000
  },
  "AllowedHosts": "*"
}
